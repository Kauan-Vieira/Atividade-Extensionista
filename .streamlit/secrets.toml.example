# Copie este arquivo para .streamlit/secrets.toml e preencha com os dados
# da sua conta de serviço do Google. No Streamlit Cloud, cole o mesmo
# conteúdo em "Manage app" > Settings > Secrets.
# O secrets.toml está no .gitignore: nunca envie as credenciais para o Git.

[sugestoes]
planilha_url = "https://docs.google.com/spreadsheets/d/COLE_O_ID_DA_PLANILHA/edit"

# Conteúdo do arquivo JSON baixado ao criar a chave da conta de serviço
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "curitiba-verde@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
